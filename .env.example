# ═══════════════════════════════════════════════════════════════
# .env.example — Credential Template
# ═══════════════════════════════════════════════════════════════
# PURPOSE: This is a TEMPLATE file — safe to push to GitHub
#          Copy this file to ".env" and fill in REAL credentials
#          .env is in .gitignore so passwords never reach GitHub
#
# HOW TO USE:
#   1. Copy:  copy .env.example .env
#   2. Edit:  fill in your real Proton Mail test account credentials
#   3. Run:   pytest  (python-dotenv loads .env automatically)
# ───────────────────────────────────────────────────────────────

# ── SENDER ACCOUNT (Account 1) ──────────────────────────────────
# The account that SENDS emails in two-account flow tests
SENDER_EMAIL=your_sender_account@proton.me
SENDER_PASSWORD=your_sender_password

# ── RECEIVER ACCOUNT (Account 2) ────────────────────────────────
# The account that RECEIVES emails in two-account flow tests
RECEIVER_EMAIL=your_receiver_account@proton.me
RECEIVER_PASSWORD=your_receiver_password

# ── APPLICATION URL ─────────────────────────────────────────────
BASE_URL=https://proton.me/mail

# ── BROWSER SETTINGS ────────────────────────────────────────────
# Override browser for this run: chromium | firefox | webkit
BROWSER=chromium

# Run in headless mode? true = no browser window (for CI)
HEADLESS=false

# ── TEST SETTINGS ────────────────────────────────────────────────
# Default timeout for actions in milliseconds
DEFAULT_TIMEOUT=30000

# Slow-motion delay between actions in ms (useful for debugging)
# Set to 0 for normal speed, 500 for visible slow-mo
SLOW_MO=0
