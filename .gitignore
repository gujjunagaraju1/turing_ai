# ═══════════════════════════════════════════════════════════════
# .gitignore — Files That Should NEVER Go to GitHub
# ═══════════════════════════════════════════════════════════════

# ── SECRETS (most important!) ────────────────────────────────────
.env                    # real credentials — NEVER commit
.env

# ── PYTHON CACHE ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.egg-info/

# ── PLAYWRIGHT & ALLURE ARTIFACTS ──────────────────────────────
reports/videos/         # test videos (large files)
reports/traces/         # trace zip files (large files)
reports/screenshots/    # failure screenshots
reports/allure-results/ # allure raw json results
reports/allure-report/  # generated allure html report
tools/                  # local tooling binaries

# ── REPORT HTML (optional — commit if you want to share results)─
# reports/report.html

# ── VIRTUAL ENVIRONMENT ─────────────────────────────────────────
venv/
.venv/
env/

# ── IDE / OS FILES ──────────────────────────────────────────────
.idea/
.vscode/
*.DS_Store
Thumbs.db
